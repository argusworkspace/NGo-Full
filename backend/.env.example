# ==========================================
# Environment Configuration (Backend Example)
# ==========================================

APP_ENV=development
APP_SECRET_KEY=replace-with-secure-32-byte-hex-key
ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database URL (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ngo_db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: enables AI-shortened summaries of long-text survey answers on the
# admin Impact Dashboard. Leave blank to fall back to a non-LLM summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
